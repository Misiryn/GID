// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------

model User {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  name           String?
  email          String   @unique
  hashedPassword String?
  role           String   @default("USER")

  tokens   Token[]
  sessions Session[]
  Service  Service[]
  Order    Order[]
}

model Session {
  id                 Int       @id @default(autoincrement())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  expiresAt          DateTime?
  handle             String    @unique
  hashedSessionToken String?
  antiCSRFToken      String?
  publicData         String?
  privateData        String?

  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int?
}

model Token {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hashedToken String
  type        String
  expiresAt   DateTime
  sentTo      String

  user   User @relation(fields: [userId], references: [id])
  userId Int

  @@unique([hashedToken, type])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  icon        String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]
}

model Service {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  details     String
  price       Int
  offerPrice  Int
  coverImage  String
  duration    String?   @default("60 mins")
  rating      Float?    @default(4.8)
  reviewCount Int?      @default(120)
  inclusions  String?
  exclusions  String?
  badge       String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  Int?
  createdBy   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      Int
  Order       Order[]
}

model Order {
  id              Int      @id @default(autoincrement())
  service         Service  @relation(fields: [serviceId], references: [id])
  serviceDateTime DateTime
  timeSlot        String?  @default("09:00 AM - 11:00 AM")
  status          String   @default("CONFIRMED")
  partnerName     String?  @default("Verified Professional")
  partnerRating   Float?   @default(4.9)
  paymentMethod   String?  @default("PAY_AFTER_SERVICE")
  createdBy       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  total           Int
  isCompleted     Boolean  @default(false)
  address         String
  is_paid         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  serviceId       Int
  userId          Int
}
